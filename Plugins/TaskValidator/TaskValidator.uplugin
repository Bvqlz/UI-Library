{
	"FileVersion": 3,
	"Version": 2,
	"VersionName": "0.2.0",
	"FriendlyName": "Task Validator",
	"Description": "Records task success, attempts, time on task, time to first interaction and the interaction methods used for hand tracking user studies, and writes one CSV per session. Knows nothing about any interaction system: interaction code reports to it.",
	"Category": "Testing",
	"CreatedBy": "Hand Tracking UI Library team",
	"CanContainContent": false,
	"EnabledByDefault": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "TaskValidator",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "TaskValidatorEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	]
}

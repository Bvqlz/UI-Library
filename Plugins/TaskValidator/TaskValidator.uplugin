{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "Task Validator",
	"Description": "Records task success, attempts, time on task and time to first interaction for hand tracking user studies, and writes one CSV per session.",
	"Category": "Testing",
	"CreatedBy": "Hand Tracking UI Library team",
	"CanContainContent": false,
	"EnabledByDefault": true,
	"Installed": false,
	"Modules": [
		{
			"Name": "TaskValidator",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "TaskValidatorDemo",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "TaskValidatorEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "XRBase",
			"Enabled": true
		}
	]
}

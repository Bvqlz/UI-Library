# Unreal generated output
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/

# Visual Studio / IDE generated files
/.vs/
/*.sln
/*.slnx
*.VC.db
*.opendb
*.suo
*.user

# Plugins: the Meta SDK plugins are installed per machine (see README.md) and stay ignored.
# The project's own plugins are source and are committed.
/Plugins/*
!/Plugins/HandTrackingTools/
!/Plugins/TaskValidator/
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
/MetaXRInteraction/

# Tool binary the Meta XR plugin downloads on demand
/Content/Oculus/Tools/

# Generated at packaging time; keep only hand-maintained manifest additions
/Build/*
!/Build/Android/
/Build/Android/*
!/Build/Android/ManifestRequirementsAdditions.txt

# Local agent settings
.claude/settings.local.json
